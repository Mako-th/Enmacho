<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TH09.Shell.ViewModels"
             xmlns:data="using:TH09.Shell.Data"
             x:Class="TH09.Shell.Views.HistoryTabView"
             x:DataType="vm:HistoryTabViewModel">


  <UserControl.KeyBindings>
    <KeyBinding Gesture="Delete" Command="{Binding RequestDeleteCommand}" />
    <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="Padding" Value="{StaticResource CellPad}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.best">
      <Setter Property="Background" Value="{StaticResource BestBg}" />
    </Style>
    <Style Selector="Border.recordless TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Sub}" />
    </Style>
    <Style Selector="TextBlock.mark">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource Sub}" />
    </Style>
    <Style Selector="Button.header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="{StaticResource HeadPad}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Sub}" />
    </Style>
    <Style Selector="Button.header.on">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="12,3,12,4" />
      <Setter Property="Foreground" Value="{StaticResource Sub}" />
    </Style>
    <Style Selector="Button.segment.on">
      <Setter Property="BorderBrush" Value="{StaticResource Fg}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid>

  <DockPanel LastChildFill="True">

    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}" Padding="16,8,16,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
        <Button Grid.Column="0" Classes="segment" Classes.on="{Binding IsLive}"
                Content="実プレイ" Command="{Binding ShowLiveCommand}" />
        <Button Grid.Column="1" Classes="segment" Classes.on="{Binding IsReplay}"
                Content="リプレイ再生" Command="{Binding ShowReplayCommand}" />
        <Button Grid.Column="2" Classes="segment" Classes.on="{Binding IsAll}"
                Content="全て" Command="{Binding ShowAllCommand}" />
        <TextBlock Grid.Column="3" Name="HistoryLegend" Classes="note" Text="{Binding Legend}"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Margin="12,0,6,6" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="4" Name="HistoryProtectedCount" Classes="note" Text="{Binding ProtectedText}"
                   VerticalAlignment="Center" Margin="0,0,16,6" />
        <TextBlock Grid.Column="5" Classes="note" Text="{Binding CountText}" VerticalAlignment="Center"
                   Margin="0,0,10,6" />
        <Button Grid.Column="6" Name="HistoryPrune" Content="{Binding PruneButtonText}"
                Command="{Binding RequestPruneCommand}" Margin="0,0,8,6" />
        <Button Grid.Column="7" Content="読み直す" Command="{Binding ReloadCommand}"
                Margin="0,0,0,6" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Padding="{StaticResource BandPad}"
            IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
    </Border>

    <ScrollViewer Name="HistoryScroll"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <DockPanel MinWidth="{x:Static vm:HistoryTabViewModel.RowsWidth}" LastChildFill="True">

    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Rule}" Padding="16,0">
      <ItemsControl Name="HeaderRow" ItemsSource="{Binding Headers}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryHeader">
            <Button Classes="header" Classes.on="{Binding IsActive}" Width="{Binding Width}"
                    Command="{Binding $parent[ItemsControl].((vm:HistoryTabViewModel)DataContext).SortByCommand}"
                    CommandParameter="{Binding Key}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="mark" Text="{Binding Arrow}"
                           Width="{Binding LeftSeat}" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" Classes.num="{Binding RightAligned}" />
                <TextBlock Grid.Column="2" Classes="mark" Text="{Binding Arrow}"
                           Width="{Binding RightSeat}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <ListBox Classes="table" Name="RowsList"
             ItemsSource="{Binding Rows}"
             SelectionMode="Multiple"
             Selection="{Binding Selection}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             Background="Transparent" BorderThickness="0" Padding="16,0">
      <ListBox.ContextFlyout>
        <MenuFlyout>
          <MenuItem Header="{Binding OpenDetailText}" Command="{Binding OpenSelectedCommand}" />
          <MenuItem Header="{Binding DeleteMenuText}" Command="{Binding RequestDeleteCommand}"
                    IsEnabled="{Binding HasSelection}" />
        </MenuFlyout>
      </ListBox.ContextFlyout>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="data:HistoryRow">
          <Border Classes.best="{Binding IsProtected}" Classes.recordless="{Binding IsRecordless}">
            <ItemsControl ItemsSource="{Binding Cells}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="data:ReplayCell">
                  <TextBlock Classes="cell" Text="{Binding Text}" Width="{Binding Width}"
                             Classes.num="{Binding RightAligned}"
                             Classes.muted="{Binding IsMuted}"
                             Classes.p1="{Binding IsP1}" Classes.p2="{Binding IsP2}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    </DockPanel>
    </ScrollViewer>

  </DockPanel>

  <Border Name="HistoryDeleteConfirm" IsVisible="{Binding IsDeleteConfirmOpen}" Background="{StaticResource Scrim}">
    <Border Background="{StaticResource Cushion1}" BorderBrush="{StaticResource Rule}" BorderThickness="1"
            CornerRadius="4" Padding="20" MaxWidth="520"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Orientation="Vertical" Spacing="12">
        <TextBlock Text="{Binding DeleteConfirmHeader}" FontWeight="Bold" />
        <TextBlock Text="{Binding DeleteConfirmText}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Name="HistoryDeleteYes" Content="はい" MinWidth="80"
                  Command="{Binding ConfirmDeleteCommand}" />
          <Button Name="HistoryDeleteNo" Content="いいえ" MinWidth="80"
                  Command="{Binding CancelDeleteCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>

  <Border Name="HistoryPruneConfirm" IsVisible="{Binding IsPruneConfirmOpen}" Background="{StaticResource Scrim}">
    <Border Background="{StaticResource Cushion1}" BorderBrush="{StaticResource Rule}" BorderThickness="1"
            CornerRadius="4" Padding="20" MaxWidth="520"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Orientation="Vertical" Spacing="12">
        <TextBlock Text="{Binding PruneConfirmHeader}" FontWeight="Bold" />
        <TextBlock Text="{Binding PruneConfirmText}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Name="HistoryPruneYes" Content="はい" MinWidth="80"
                  Command="{Binding ConfirmPruneCommand}" />
          <Button Name="HistoryPruneNo" Content="いいえ" MinWidth="80"
                  Command="{Binding CancelPruneCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>

  <Border Name="HistoryNotice" IsVisible="{Binding IsNoticeOpen}" Background="{StaticResource Scrim}">
    <Border Background="{StaticResource Cushion1}" BorderBrush="{StaticResource Rule}" BorderThickness="1"
            CornerRadius="4" Padding="20" MaxWidth="520"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Orientation="Vertical" Spacing="12">
        <TextBlock Text="{Binding NoticeTitle}" FontWeight="Bold" />
        <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Name="HistoryNoticeClose" Content="閉じる" MinWidth="80"
                  Command="{Binding CloseNoticeCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>

  </Grid>
</UserControl>
